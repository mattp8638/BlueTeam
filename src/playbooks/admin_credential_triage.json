{
  "type": "playbook",
  "id": "playbook--4f8e32a1-12c8-4b2a-89f4-112233445566",
  "name": "Admin Credential Triage",
  "workflow": {
    "step--evaluate-ip-risk": {
      "type": "switch",
      "name": "Check IP Context",
      "switch_variable": "$.event.src_endpoint_ip",
      "cases": {
        "10.0.0.50": "step--log-case-notes",
        "default": "step--isolate-endpoint"
      }
    },
    "step--log-case-notes": {
      "type": "action",
      "target_service": "TICKETING_CORE",
      "command": "ticket_update --note 'Internal IP confirmed, false positive.'",
      "on_completion": "end"
    },
    "step--isolate-endpoint": {
      "type": "action",
      "target_service": "ANTIVIRUS_CORE",
      "command": "agent_control --isolate --host_ip $.event.src_endpoint_ip",
      "on_completion": "step--update-ticket"
    },
    "step--update-ticket": {
      "type": "action",
      "target_service": "TICKETING_CORE",
      "command": "ticket_update --status 'CONTAINED'",
      "on_completion": "end"
    }
  }
}
